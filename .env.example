# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG
# ==========================================
# Server Port
SERVER_PORT=8080

# --- CẤU HÌNH DATABASE POSTGRESQL (Khớp với docker-compose) ---
POSTGRES_DB=news_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# URL kết nối khi chạy Spring Boot trên máy Host (IntelliJ / VS Code / Maven)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/news_management_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres123
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Sử dụng validate khi dùng Flyway migration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true

# --- CẤU HÌNH PGADMIN 4 ---
PGADMIN_EMAIL=admin@uth.edu.vn
PGADMIN_PASSWORD=admin123

# --- CẤU HÌNH JWT BẢO MẬT ---
JWT_SECRET=NewsManagementSecretKeyForJwtAuthenticationMustBeAtLeast256BitsLong2026!
JWT_EXPIRATION_MS=86400000

# --- CẤU HÌNH UPLOAD FILE ---
APP_UPLOAD_DIR=./uploads
APP_UPLOAD_MAX_FILE_SIZE=5MB
